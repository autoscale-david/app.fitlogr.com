{
  "name": "@fitlogr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply fitlogr-db --local --env local",
    "migrate:remote": "wrangler d1 migrations apply fitlogr-db --remote"
  },
  "dependencies": {
    "@fitlogr/shared": "*",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.54.0"
  }
}
