# =============================================================================
# fitlogr Environment Variables & Secrets Template
# Copy to .env (or worker/.dev.vars for local Wrangler).
# Never commit real secret values. Production secrets live in Cloudflare Worker
# Secrets and GitHub Actions / Cursor Secrets using these exact names.
# =============================================================================

# --- Deployment & CI Secrets (GitHub Actions / Cursor Secrets) ---------------
# Cloudflare deployment token (Wrangler / D1 migrations)
CLOUDFLARE_API_TOKEN=

# Expo EAS access token (configured in Cursor Secrets as EXPO_DEV_TOKEN).
# Note: eas-cli reads EXPO_TOKEN at runtime, so export EXPO_TOKEN="$EXPO_DEV_TOKEN"
# before running eas-cli commands locally or in CI.
EXPO_DEV_TOKEN=

# --- Cloudflare Worker Secrets (configure via `wrangler secret put`) ---------
# Centralized Google Web OAuth client credentials (fitlogr-app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OpenRouter API key (backend-only; never expose to the mobile app)
OPENROUTER_API_KEY=

# Base64-encoded 256-bit key for AES-256-GCM OAuth refresh token encryption
TOKEN_ENCRYPTION_KEY=

# HMAC-SHA256 signing key for fitlogr application session JWTs
SESSION_SECRET=

# --- Cloudflare Configuration (non-secret) -----------------------------------
CLOUDFLARE_ACCOUNT_ID=42aad73fe98811972eccd8907196d722
CLOUDFLARE_ZONE_ID=4da8c98a66722b963535773610a7d0d8

# --- Google Cloud & Google Photos Configuration (non-secret) -----------------
GOOGLE_CLOUD_PROJECT_ID=fitlogr-app
GOOGLE_OAUTH_REDIRECT_URI=https://fitlogr.com/api/auth/google/callback
GOOGLE_PHOTOS_ALBUM_NAME=fitlogr

# --- OpenRouter Configuration (non-secret) -----------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=
OPENROUTER_TEXT_MODEL=
OPENROUTER_TEXT_FALLBACK_MODELS=

# --- Application URLs (non-secret) -------------------------------------------
APP_URL=https://fitlogr.com
API_BASE_URL=https://fitlogr.com/api

# --- Mobile Public Configuration (bundled into Expo client; non-secret only) -
EXPO_PUBLIC_API_BASE_URL=https://fitlogr.com/api
